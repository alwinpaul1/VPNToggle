<Window x:Class="VPNToggle.CardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="BTU VPN" Width="340" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="Transparent" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{Binding OutlineBrush}" BorderThickness="1" CornerRadius="8">
        <StackPanel x:Name="Root" Margin="18,16,18,18">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="Slide"/>
            </StackPanel.RenderTransform>

            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="/app.ico" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="BTU VPN" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Host}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
                <Button x:Name="MoreButton" Grid.Column="2" Style="{StaticResource IconButton}" Click="More_Click" ToolTip="More">
                    <TextBlock Text="&#xE712;" FontFamily="{StaticResource Icons}" FontSize="14"/>
                </Button>
            </Grid>

            <!-- Power switch: neutral in every state; the state shows in the symbol colour, a slim ring,
                 the coloured status word and the card's hairline outline (NordVPN-style restraint). -->
            <Grid Margin="0,22,0,0" HorizontalAlignment="Center" Width="104" Height="104">
                <!-- soft halo while connected -->
                <Ellipse Width="90" Height="90" Fill="{Binding Tint}" Opacity="0.28"
                         Visibility="{Binding Glow, Converter={StaticResource BoolToVis}}">
                    <Ellipse.Effect>
                        <BlurEffect Radius="22"/>
                    </Ellipse.Effect>
                </Ellipse>
                <!-- slim ring when connected or dropped -->
                <Ellipse Width="98" Height="98" StrokeThickness="2" Stroke="{Binding Tint}"
                         Visibility="{Binding Lit, Converter={StaticResource BoolToVis}}"/>
                <!-- spinning arc while working -->
                <Path Width="98" Height="98" Stroke="#3F86FF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M49,1 A48,48 0 0 1 97,49" RenderTransformOrigin="0.5,0.5"
                      Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="Spin"/>
                    </Path.RenderTransform>
                    <Path.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="Spin" Storyboard.TargetProperty="Angle"
                                                     From="0" To="360" Duration="0:0:0.9"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Path.Triggers>
                </Path>
                <Button Click="Toggle_Click" Cursor="Hand" IsEnabled="{Binding NotBusy}" IsDefault="True"
                        AutomationProperties.Name="{Binding ButtonText}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Body" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="Press"/>
                                </Grid.RenderTransform>
                                <Ellipse x:Name="Orb" Width="84" Height="84" Fill="{DynamicResource OrbFill}"
                                         Stroke="{DynamicResource SurfaceStroke}" StrokeThickness="1"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Orb" Property="Fill" Value="{DynamicResource OrbFillHover}"/></Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Body" Property="RenderTransform">
                                        <Setter.Value><ScaleTransform ScaleX="0.94" ScaleY="0.94"/></Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource Icons}" FontSize="30" Foreground="{Binding GlyphBrush}"/>
                </Button>
            </Grid>

            <TextBlock Text="{Binding Title}" Foreground="{Binding TitleBrush}" FontSize="18" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,14,0,0"/>
            <!-- live session timer while connected -->
            <TextBlock Text="{Binding Clock}" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,3,0,0"
                       FontFamily="Segoe UI Variable Text, Segoe UI" Typography.NumeralAlignment="Tabular"
                       Foreground="{DynamicResource TextSecondary}"
                       Visibility="{Binding Connected, Converter={StaticResource BoolToVis}}"/>

            <!-- Details -->
            <Border Margin="0,18,0,0" CornerRadius="8" Background="{DynamicResource CardFill}"
                    BorderBrush="{DynamicResource CardStroke}" BorderThickness="1" Padding="12,4">
                <StackPanel>
                    <StackPanel.Resources>
                        <Style x:Key="RowIcon" TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Width" Value="24"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                        </Style>
                        <Style x:Key="RowLabel" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                        </Style>
                        <Style x:Key="RowValue" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </StackPanel.Resources>

                    <DockPanel Height="34" Visibility="{Binding Connected, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource RowIcon}" Text="&#xE774;"/>
                        <TextBlock Style="{StaticResource RowLabel}" Text="IP address"/>
                        <TextBlock Style="{StaticResource RowValue}" Text="{Binding Ip}"/>
                    </DockPanel>
                    <DockPanel Height="34">
                        <TextBlock Style="{StaticResource RowIcon}" Text="&#xE8D7;"/>
                        <TextBlock Style="{StaticResource RowLabel}" Text="Two-factor"/>
                        <TextBlock Style="{StaticResource RowValue}" Text="{Binding TwoFactor}"/>
                    </DockPanel>
                    <DockPanel Height="34">
                        <TextBlock Style="{StaticResource RowIcon}" Text="&#xE72C;"/>
                        <TextBlock Style="{StaticResource RowLabel}" Text="Auto-reconnect"/>
                        <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                      IsChecked="{Binding AutoReconnect, Mode=TwoWay}"/>
                    </DockPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </Border>
</Window>
