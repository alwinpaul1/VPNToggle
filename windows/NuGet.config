<?xml version="1.0" encoding="utf-8"?>
<!-- Names nuget.org explicitly, so a fresh .NET SDK with no package source configured
     (error NU1100 "Unable to resolve ...") can still restore. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
